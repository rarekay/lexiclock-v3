# Never cache the entry points
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache

# General assets
/words/*
  Cache-Control: public, max-age=31536000

/icons/*
  Cache-Control: public, max-age=31536000

/*.css
  Cache-Control: public, max-age=86400

# Versioned files: a new version gets a new file name, so these can be cached for good
/app.v3.0.0.js
  Cache-Control: public, max-age=31536000, immutable

/explore.v3.0.0.js
  Cache-Control: public, max-age=31536000, immutable

/style.v3.0.0.css
  Cache-Control: public, max-age=31536000, immutable

/train.v3.0.0.js
  Cache-Control: public, max-age=31536000, immutable
